<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tonari · CHUNITHM 联机助手"
 Width="1000" Height="820" MinWidth="720" MinHeight="680" WindowStartupLocation="CenterScreen"
 Background="#F2F5FA" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#1C2B42"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#69778D"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="20"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderBrush" Value="#DFE6F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="24"/></Style>
  <Style x:Key="Divider" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="#E7ECF3"/><Setter Property="Margin" Value="0,24"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#35465F"/><Setter Property="BorderBrush" Value="#CCD7E6"/><Setter Property="Padding" Value="16,8"/><Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2563EB"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2864DC"/><Setter Property="BorderBrush" Value="#2864DC"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="ModeSwitch" TargetType="ToggleButton">
   <Setter Property="Width" Value="56"/><Setter Property="Height" Value="32"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="SwitchTrack" Background="#C9D3E2" BorderBrush="Transparent" BorderThickness="1" CornerRadius="16"><Ellipse x:Name="SwitchThumb" Width="22" Height="22" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="#2864DC"/><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#173F91"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="SwitchTrack" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="40"/><Setter Property="BorderBrush" Value="#CCD7E6"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#AAC5FF"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="40"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="CheckBox"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,2,0,2"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/><Setter Property="Foreground" Value="#69778D"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="Transparent" CornerRadius="8" Margin="0,0,8,0"><ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#E8EEF8"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#E4EDFD"/><Setter Property="Foreground" Value="#235CC5"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Expander"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Width="40" Height="40" Background="#E2EBFD" CornerRadius="10" VerticalAlignment="Center"><Canvas Width="28" Height="28"><Path Data="M 7,7 L 21,7 21,21 7,21 Z" Stroke="#3267D5" StrokeThickness="2"/><Ellipse Width="7" Height="7" Fill="#3267D5" Canvas.Left="3.5" Canvas.Top="3.5"/><Ellipse Width="7" Height="7" Fill="#3267D5" Canvas.Left="17.5" Canvas.Top="3.5"/><Ellipse Width="7" Height="7" Fill="#3267D5" Canvas.Left="3.5" Canvas.Top="17.5"/><Ellipse Width="7" Height="7" Fill="#3267D5" Canvas.Left="17.5" Canvas.Top="17.5"/></Canvas></Border>
   <TextBlock Grid.Column="1" Text="Tonari" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0" TextWrapping="NoWrap"/>
   <StackPanel Grid.Column="2" VerticalAlignment="Center"><Border x:Name="RoleBadge" Background="#E5ECF7" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right"><TextBlock x:Name="RoleBadgeText" Text="角色未设置" FontSize="12" Foreground="#455F86"/></Border><TextBlock x:Name="PrivilegeStatus" Text="v3.6.0" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel>
  </Grid>
  <TabControl x:Name="MainTabs" Grid.Row="1" SelectedIndex="0" Background="Transparent" BorderThickness="0" Padding="0">
   <TabItem Header="联机概览"><ScrollViewer Margin="0,16,0,0" Focusable="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextElement.FontWeight="Normal" TextElement.Foreground="#1C2B42"><StackPanel Margin="0,0,4,0">
    <Border x:Name="ModePanel" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="游玩模式" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="单机" VerticalAlignment="Center" Margin="0,0,8,0"/><ToggleButton x:Name="NetworkModeToggle" Style="{StaticResource ModeSwitch}" IsChecked="False" AutomationProperties.Name="游玩模式：关闭为单机，开启为联机"/><TextBlock Text="联机" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Grid>
     <TextBlock x:Name="ModeStatus" Text="请选择游戏 bin 文件夹。" Margin="0,16,0,0"/>
     <TextBlock x:Name="ModeHint" Text="选择游戏目录后读取机器状态。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
     <TextBlock x:Name="RoomProfileSummary" Text="尚未保存联机房间。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
    </StackPanel></Border>
    <Border x:Name="NetworkOverviewPanel" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Headline" Text="配置联机房间" Style="{StaticResource SectionTitle}"/><Border x:Name="StatusBadge" Grid.Column="1" Background="#EDF1F7" CornerRadius="8" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Top"><TextBlock x:Name="StatusBadgeText" Text="尚未配置" FontSize="12" Foreground="#69778D"/></Border></Grid>
     <TextBlock x:Name="Description" Text="在“房间设置”中填写或导入网络信息。" Style="{StaticResource Caption}" Margin="0,8,0,8"/>
     <TextBlock x:Name="RoomSummary" Text="1 台基准机，最多 3 台接入机。" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
     <WrapPanel><Button x:Name="RefreshButton" Content="检测网络" Style="{StaticResource Primary}"/><Button x:Name="PeersButton" Content="检测设备"/></WrapPanel>
    </StackPanel></Border>
    <Border x:Name="MembersPanel" Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock x:Name="MembersTitle" Text="房间设备" Style="{StaticResource SectionTitle}" Margin="8,0,0,8"/><TextBlock x:Name="MembersHint" Text="检查参与设备的地址与网络回应。" Style="{StaticResource Caption}" Margin="8,0,8,8"/><UniformGrid x:Name="DeviceGrid" Columns="1"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>

   <TabItem Header="房间设置"><ScrollViewer Margin="0,16,0,0" Focusable="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextElement.FontWeight="Normal" TextElement.Foreground="#1C2B42"><StackPanel Margin="0,0,4,0">
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="本机角色" Style="{StaticResource SectionTitle}"/>
     <TextBlock x:Name="RoleEditorHint" Text="每个房间设置 1 台基准机，其余机器选择不同机号。" Style="{StaticResource Caption}" Margin="0,8,0,16"/>
     <ComboBox x:Name="SlotInput" AutomationProperties.Name="本机位置" Margin="0,0,0,24"><ComboBoxItem Content="1 号 · 基准机（.11）"/><ComboBoxItem Content="2 号 · 接入机（.12）"/><ComboBoxItem Content="3 号 · 接入机（.13）"/><ComboBoxItem Content="4 号 · 接入机（.14）"/></ComboBox>
     <Grid x:Name="SettingsFields"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,16"><TextBlock Text="Network ID" Margin="0,0,0,8"/><TextBox x:Name="NetworkIdInput" MaxLength="16" FontFamily="Consolas" AutomationProperties.Name="Network ID"/></StackPanel>
      <StackPanel Grid.Row="1"><TextBlock Text="房间名称" Margin="0,0,0,8"/><TextBox x:Name="RoomNameInput" MaxLength="60" AutomationProperties.Name="房间名称"/></StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="房间子网 · /24" Margin="0,0,0,8"/><TextBox x:Name="SubnetInput" MaxLength="18" FontFamily="Consolas" AutomationProperties.Name="房间子网"/><TextBlock Text="例如 192.168.139.0" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
     </Grid>
     <StackPanel x:Name="RoomActionsPanel" Margin="0,16,0,0"><WrapPanel><Button x:Name="ImportButton" Content="导入房间"/><Button x:Name="SaveButton" Content="保存房间设置" Visibility="Collapsed" VerticalAlignment="Center"/><Button x:Name="ExportButton" Content="导出房间"/></WrapPanel><TextBlock x:Name="SettingsNote" Text="保存后应用房间信息、机号与游戏配置。" Style="{StaticResource Caption}"/></StackPanel>
    </StackPanel></Border>
    <Border x:Name="NodePanel" Style="{StaticResource Card}" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本机节点 ID"/><TextBlock x:Name="NodeId" Text="检测网络后显示" FontFamily="Consolas" FontSize="18" Margin="0,8,0,0"/><TextBlock x:Name="NodeRoleHint" Text="使用节点 ID 确认成员并分配地址。" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel><Button x:Name="CopyNodeButton" Grid.Column="1" Content="复制节点 ID" Margin="16,0,0,0" VerticalAlignment="Center"/></Grid></Border>
    <Border x:Name="NetworkToolsPanel" Style="{StaticResource Card}" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="网络管理"/><TextBlock x:Name="NetworkToolsHint" Text="在 ZeroTier Central 授权成员并设置地址。" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel><Button x:Name="CentralButton" Grid.Column="1" Content="打开网络管理" Margin="16,0,0,0" VerticalAlignment="Center"/></Grid></Border>
   </StackPanel></ScrollViewer></TabItem>

   <TabItem Header="游戏设置"><ScrollViewer Margin="0,16,0,0" Focusable="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextElement.FontWeight="Normal" TextElement.Foreground="#1C2B42"><Border Style="{StaticResource Card}" Margin="0,0,4,0"><StackPanel>
    <TextBlock Text="游戏目录" Style="{StaticResource SectionTitle}"/>
    <TextBlock Text="选择 bin 文件夹后读取游戏配置、启动脚本与机器状态。点击“刷新状态”可重新读取。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
    <TextBlock Text="bin 文件夹" Margin="0,16,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="BinPathInput" IsReadOnly="True" AutomationProperties.Name="游戏 bin 文件夹路径"/><Button x:Name="BrowseBinButton" Grid.Column="1" Content="选择文件夹" Margin="8,0,0,0"/><Button x:Name="RefreshFilesButton" Grid.Column="2" Content="刷新状态" Margin="8,0,0,0"/></Grid>
    <TextBlock x:Name="IniReadStatus" Text="游戏配置 · 尚未读取 segatools.ini。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
    <TextBlock x:Name="BatReadStatus" Text="启动脚本 · 尚未读取 start.bat。" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
    <TextBlock x:Name="TestReadStatus" Text="当前机器状态：尚未读取。" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
    <Button x:Name="RetryFilesButton" Content="重试读取" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,16,0,0"/>
    <Border Style="{StaticResource Divider}"/>
    <TextBlock Text="启动补丁" Style="{StaticResource SectionTitle}"/>
    <TextBlock x:Name="PatchEmptyHint" Text="读取游戏目录后，显示可用补丁。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
    <StackPanel x:Name="PatchOptionsPanel" Visibility="Collapsed" Margin="0,8,0,0">
     <TextBlock x:Name="LaunchRoleHint" Text="基准机" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
     <StackPanel><CheckBox x:Name="ConnectFixCheck" Content="修正连接等待" AutomationProperties.Name="修正连接等待"/><TextBlock x:Name="ConnectPatchHint" Text="接入机卡在「Aグループ基準機から設定を取得します」时，基准机和接入机都要启用。" Style="{StaticResource Caption}" Margin="24,8,0,0"/><TextBlock x:Name="ConnectCompatibility" Text="检测后显示兼容性。" Style="{StaticResource Caption}" Margin="24,4,0,0"/></StackPanel>
     <Border x:Name="DistributionOptionCard" Margin="0,16,0,0"><StackPanel><CheckBox x:Name="DistributionFixCheck" Content="配信启动修复" AutomationProperties.Name="配信启动修复"/><TextBlock x:Name="DistributionPatchHint" Text="接入机停在「配信サーバーを探しています」时，在基准机启用。" Style="{StaticResource Caption}" Margin="24,8,0,0"/><TextBlock x:Name="DistributionCompatibility" Text="读取后检查兼容性。" Style="{StaticResource Caption}" Margin="24,4,0,0"/></StackPanel></Border>
     <TextBlock Text="补丁在下次启动游戏时生效。" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
    </StackPanel>
   </StackPanel></Border></ScrollViewer></TabItem>
   <TabItem Header="帮助与诊断"><ScrollViewer Margin="0,16,0,0" Focusable="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextElement.FontWeight="Normal" TextElement.Foreground="#1C2B42"><StackPanel Margin="0,0,4,0">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="GuideTitle" Text="使用教程" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="GuideDescription" Text="根据本机角色完成房间和游戏配置。" Style="{StaticResource Caption}" Margin="0,8,0,16"/><WrapPanel><Button x:Name="HostGuideButton" Content="基准机教程" Style="{StaticResource Primary}"/><Button x:Name="ClientGuideButton" Content="接入机教程"/></WrapPanel></StackPanel></Border>
    <Border x:Name="NetworkDiagnosticsPanel" Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
     <TextBlock Text="网络诊断" Style="{StaticResource SectionTitle}"/>
     <TextBlock x:Name="FirewallRoleHint" Text="为游戏、配信服务和 Ping 配置房间子网的入站规则。" Style="{StaticResource Caption}" Margin="0,8,0,16"/>
     <WrapPanel><Button x:Name="FirewallButton" Content="配置防火墙"/><Button x:Name="DiagnosticsButton" Content="导出诊断"/></WrapPanel>
     <TextBlock x:Name="SetupResult" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
     <Expander x:Name="NetworkDetailsPanel" Header="网络详细信息" Margin="0,8,0,0"><TextBlock x:Name="NetworkDetails" Text="检测后显示网络信息。" Style="{StaticResource Caption}" Margin="0,8,0,0"/></Expander>
    </StackPanel></Border>
    <Expander Header="活动记录" Margin="8,16,8,0"><TextBox x:Name="ActivityLog" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="168" Background="#F7F9FC" Margin="0,8,0,0"/></Expander>
    <Border x:Name="ToolsPanel" Style="{StaticResource Card}" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ZeroTier 客户端"/><TextBlock Text="用于连接联机房间网络。" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel><Button x:Name="DownloadButton" Grid.Column="1" Content="下载 ZeroTier" Margin="16,0,0,0" VerticalAlignment="Center"/></Grid></Border>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <Border x:Name="LaunchBar" Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="LaunchHomeSummary" Text="尚未选择游戏" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="LaunchHomeStatus" Text="在“游戏设置”中选择 bin 文件夹。" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
   <Button x:Name="LaunchHomeButton" Grid.Column="2" Content="启动游戏" Style="{StaticResource Primary}" MinWidth="112" Margin="0" VerticalAlignment="Center"/>
  </Grid></Border>
 </Grid>
</Window>
